PORT=3000
HTTP_TIMEOUT_MS=8000

# URLs base dos microsserviços. Na rede da faculdade, troque apenas os IPs/portas.
PRODUTOS_API_URL=http://localhost:3001
PRODUTOS_API_PATH=/produtos

# Score real: porta informada pelo grupo = 8080
# Na rede da faculdade, você pode colar exatamente o molde recebido do grupo:
# SCORE_API_URL=http://IP-DO-SCORE:8080/api/v1/score/evaluate
# Também funciona usando apenas a base e deixando SCORE_API_PATH separado.
SCORE_API_URL=http://localhost:3002
SCORE_API_PATH=/api/v1/score/evaluate

# Decisão real: porta informada pelo grupo = 8081
# Na rede da faculdade, use por exemplo: DECISAO_API_URL=http://IP-DA-DECISAO:8081
DECISAO_API_URL=http://localhost:3003
DECISAO_API_PATH=/api/v1/decisao

# Juros NÃO é chamado pelo CredCasa. A Decisão integra Juros e devolve integracaoJuros.

OPERACOES_API_URL=http://localhost:3005
OPERACOES_API_PATH=/operacoes

# Opcional: chatbot do site
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
